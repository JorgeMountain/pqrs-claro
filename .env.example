# Copia este archivo a .env.local y configura credenciales propias.
# .env.local y .env.jev.local están excluidos de Git.
OPENAI_API_KEY=
# Alternativa: leer OPENAI_API_KEY desde otro archivo autorizado.
# PQRS_CLARO_KEY_FILE=C:/ruta/propia/configuracion/.env.local
PQRS_CLARO_MODEL=gpt-6-luna
# Redacciones simultáneas (1 a 6). El valor predeterminado es 3.
PQRS_CLARO_DRAFT_CONCURRENCY=3
# El arranque unificado usa 8772; se cambia con scripts/start.ps1 -Port 8782.
# Solo la clasificación de tipos puede usar JEV. Consulta docs/JEV_CLASIFICACION.md.
PQRS_CLARO_CLASSIFICATION_PROVIDER=openai
# Para JEV: cambia el proveedor a jev y guarda TYPESAFE_API_KEY en el archivo indicado.
# PQRS_CLARO_JEV_KEY_FILE=.env.jev.local
# Para aislar datos usa la variable de entorno en PowerShell, no este archivo:
# $env:PQRS_CLARO_DATA_DIR = Join-Path $PWD 'output/qa/mi-entorno'
